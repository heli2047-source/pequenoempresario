---
interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url, description = '' } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const twitterShare = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const whatsAppShare = `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`;
---

<div class="share-buttons-container flex items-center gap-2 flex-wrap" data-title={title} data-url={url} data-text={description}>
  <span class="text-xs font-semibold uppercase tracking-wider text-sp-text-muted mr-1">Compartilhar:</span>

  <!-- Web Share API (botão nativo para mobile/desktop moderno) -->
  <button
    type="button"
    class="web-share-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-sp-border bg-sp-bg-elevated hover:bg-sp-surface text-sp-text hover:text-sp-primary hover:border-sp-primary/40 transition-all duration-200 shadow-xs"
    aria-label="Compartilhar via sistema"
  >
    <svg class="w-3.5 h-3.5 text-sp-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    Compartilhar
  </button>

  <!-- Fallback X / Twitter -->
  <a
    href={twitterShare}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-sp-border bg-sp-bg-elevated hover:bg-sp-surface text-sp-text hover:text-sp-primary hover:border-sp-primary/50 transition-all duration-200 shadow-xs"
    aria-label="Compartilhar no X (Twitter)"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
  </a>

  <!-- Fallback LinkedIn -->
  <a
    href={linkedInShare}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-sp-border bg-sp-bg-elevated hover:bg-sp-surface text-sp-text hover:text-[#0a66c2] hover:border-[#0a66c2]/50 transition-all duration-200 shadow-xs"
    aria-label="Compartilhar no LinkedIn"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
    </svg>
  </a>

  <!-- Fallback WhatsApp -->
  <a
    href={whatsAppShare}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-sp-border bg-sp-bg-elevated hover:bg-sp-surface text-sp-text hover:text-[#22c55e] hover:border-[#22c55e]/50 transition-all duration-200 shadow-xs"
    aria-label="Compartilhar no WhatsApp"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- Copiar Link -->
  <button
    type="button"
    class="copy-link-btn inline-flex items-center justify-center w-8 h-8 rounded-full border border-sp-border bg-sp-bg-elevated hover:bg-sp-surface text-sp-text hover:text-sp-primary hover:border-sp-primary/50 transition-all duration-200 shadow-xs relative"
    aria-label="Copiar link do artigo"
  >
    <svg class="copy-icon w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="copy-check-icon hidden w-3.5 h-3.5 text-sp-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span class="copy-tooltip hidden absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-sp-text text-sp-bg text-[10px] font-semibold rounded shadow-md whitespace-nowrap">Copiado!</span>
  </button>
</div>

<script is:inline>
  function setupShareButtons() {
    const containers = document.querySelectorAll('.share-buttons-container');
    containers.forEach((container) => {
      const title = container.getAttribute('data-title') || document.title;
      const url = container.getAttribute('data-url') || window.location.href;
      const text = container.getAttribute('data-text') || '';

      const webShareBtn = container.querySelector('.web-share-btn');
      if (webShareBtn) {
        if (navigator.share) {
          webShareBtn.addEventListener('click', async () => {
            try {
              await navigator.share({ title, text, url });
            } catch (err) {
              // Cancelado pelo usuário
            }
          });
        } else {
          webShareBtn.classList.add('hidden');
        }
      }

      const copyBtn = container.querySelector('.copy-link-btn');
      const copyIcon = container.querySelector('.copy-icon');
      const copyCheckIcon = container.querySelector('.copy-check-icon');
      const tooltip = container.querySelector('.copy-tooltip');

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(url);
            if (copyIcon && copyCheckIcon) {
              copyIcon.classList.add('hidden');
              copyCheckIcon.classList.remove('hidden');
            }
            if (tooltip) tooltip.classList.remove('hidden');

            setTimeout(() => {
              if (copyIcon && copyCheckIcon) {
                copyIcon.classList.remove('hidden');
                copyCheckIcon.classList.add('hidden');
              }
              if (tooltip) tooltip.classList.add('hidden');
            }, 2000);
          } catch (err) {
            console.error('Falha ao copiar:', err);
          }
        });
      }
    });
  }

  setupShareButtons();
  document.addEventListener('astro:page-load', setupShareButtons);
</script>
