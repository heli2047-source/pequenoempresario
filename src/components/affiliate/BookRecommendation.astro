---
interface Props {
  bookTitle: string;
  author: string;
  coverImage?: string;
  whyRead: string;
  slug?: string;
  externalUrl?: string;
}

const {
  bookTitle,
  author,
  coverImage,
  whyRead,
  slug = 'livro-copywriting',
  externalUrl,
} = Astro.props;

const targetHref = slug ? `/go/${slug}` : (externalUrl || '#');
---

<div class="book-recommendation my-8 p-6 rounded-2xl border border-sp-border bg-sp-bg-card shadow-sm flex flex-col sm:flex-row gap-6 items-start">
  {coverImage ? (
    <img
      src={coverImage}
      alt={`Capa do livro ${bookTitle}`}
      class="w-28 sm:w-32 h-auto rounded-lg shadow-md border border-sp-border object-cover shrink-0"
      loading="lazy"
    />
  ) : (
    <div class="w-24 sm:w-28 h-36 rounded-lg bg-sp-surface border border-sp-border flex flex-col items-center justify-center p-2 text-center shrink-0 shadow-inner">
      <span class="text-2xl mb-1">📖</span>
      <span class="text-[11px] font-bold text-sp-text leading-tight line-clamp-2">{bookTitle}</span>
      <span class="text-[9px] text-sp-text-muted mt-1">{author}</span>
    </div>
  )}

  <div class="flex-1 space-y-3">
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider rounded-full bg-sp-accent-soft text-sp-accent">
        Leitura Essencial
      </span>
      <span class="text-[11px] text-sp-text-dim">(Recomendação Prática)</span>
    </div>

    <div>
      <h4 class="text-xl font-extrabold text-sp-text tracking-tight">
        {bookTitle}
      </h4>
      <p class="text-xs font-semibold text-sp-text-muted">
        Por {author}
      </p>
    </div>

    <p class="text-sm text-sp-text-muted leading-relaxed">
      <strong class="text-sp-text font-semibold">Por que recomendamos:</strong> {whyRead}
    </p>

    <div class="pt-2">
      <a
        href={targetHref}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white bg-sp-primary hover:bg-sp-primary-hover rounded-xl shadow-sm transition-transform active:scale-95"
      >
        <span>Ver na Amazon</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>
  </div>
</div>
