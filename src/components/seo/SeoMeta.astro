---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  author?: string;
}

const {
  title,
  description = 'Tecnologia e marketing descomplicados para apoiar o pequeno empresário a superar os desafios da inserção digital e vender mais.',
  canonicalUrl = Astro.url.href,
  ogImage = '/og-image.jpg',
  type = 'website',
  publishDate,
  author = 'Heliezer Garcia',
} = Astro.props;

const siteTitle = title.includes('Pequeno Empresário') ? title : `${title} — Pequeno Empresário`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site || 'https://pequenoempresario.com.br').href;
---

<!-- Metatags Primárias -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:site_name" content="Pequeno Empresário" />
<meta property="og:locale" content="pt_BR" />

{publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{author && (
  <meta property="article:author" content={author} />
)}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />

<!-- Robots & Indexação -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
