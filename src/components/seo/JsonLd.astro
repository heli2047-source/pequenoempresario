---
interface Props {
  type?: 'WebSite' | 'Article' | 'FAQPage';
  title?: string;
  description?: string;
  url?: string;
  publishDate?: Date;
  updatedDate?: Date;
  authorName?: string;
  image?: string;
  faqItems?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; item: string }>;
}

const {
  type = 'WebSite',
  title = 'Pequeno Empresário — Tecnologia e Marketing para Pequenos Negócios',
  description = 'Portal com estratégias práticas de tecnologia, SEO local, sites de alta velocidade e vendas para apoiar o pequeno empreendedor.',
  url = Astro.url.href,
  publishDate,
  updatedDate,
  authorName = 'Heliezer Garcia',
  image = 'https://pequenoempresario.com.br/og-image.jpg',
  faqItems = [],
  breadcrumbs = [],
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://pequenoempresario.com.br/';
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image.replace(/^\//, '')}`;

const schemas: Record<string, any>[] = [];

if (type === 'Article') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': url,
    },
    headline: title,
    description: description,
    image: fullImage,
    datePublished: publishDate ? publishDate.toISOString() : new Date().toISOString(),
    dateModified: updatedDate ? updatedDate.toISOString() : (publishDate ? publishDate.toISOString() : new Date().toISOString()),
    author: {
      '@type': 'Person',
      name: authorName,
      url: `${siteUrl}sobre/`,
      image: `${siteUrl}images/heliezer-avatar.webp`,
      jobTitle: 'Fundador & Especialista em Tecnologia e Marketing',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Pequeno Empresário',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}logo.png`,
      },
    },
  });
} else if (type === 'FAQPage' && faqItems.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
} else {
  // WebSite default
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pequeno Empresário',
    url: siteUrl,
    description: description,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteUrl}blog/?search={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  });

  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Pequeno Empresário',
    url: siteUrl,
    logo: `${siteUrl}logo.png`,
    description: description,
    founder: {
      '@type': 'Person',
      name: authorName,
      url: `${siteUrl}sobre/`,
      jobTitle: 'Fundador & Especialista em Tecnologia e Marketing',
    },
    sameAs: [
      'https://www.linkedin.com/in/heliezer-garcia/',
    ],
  });
}

// Trilha de Navegação (BreadcrumbList) para Rich Snippets no Google
if (breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  });
}
---

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
